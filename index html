
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOID Studio</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #09090f;
    color: #fff;
    font-family: Arial, sans-serif;
}

header {
    padding: 20px;
    border-bottom: 1px solid #242435;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: #b66cff;
    font-size: 23px;
    font-weight: bold;
    letter-spacing: 3px;
}

.status {
    color: #00ff9d;
    font-size: 12px;
}

.container {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
}

h1 {
    margin: 20px 0 10px;
    font-size: 28px;
}

.subtitle {
    color: #888;
    margin-bottom: 25px;
}

.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.panel {
    background: #11111c;
    border: 1px solid #29293b;
    border-radius: 12px;
    padding: 20px;
}

.panel h2 {
    color: #bb77ff;
    font-size: 18px;
    margin-bottom: 20px;
}

label {
    display: block;
    color: #aaa;
    font-size: 13px;
    margin: 15px 0 7px;
}

input, textarea, select {
    width: 100%;
    padding: 12px;
    background: #080810;
    border: 1px solid #333348;
    border-radius: 7px;
    color: white;
    outline: none;
}

textarea {
    resize: vertical;
    min-height: 100px;
}

input:focus, textarea:focus, select:focus {
    border-color: #a855f7;
}

button {
    border: none;
    border-radius: 7px;
    padding: 12px 15px;
    background: #9333ea;
    color: white;
    font-weight: bold;
    cursor: pointer;
    margin-top: 15px;
}

button:hover {
    background: #a855f7;
}

.preview {
    min-height: 400px;
    background: #050509;
    border: 1px solid #29293b;
    border-radius: 12px;
    padding: 25px;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.preview h2 {
    margin: 20px 0;
    font-size: 26px;
}

.preview p {
    color: #ccc;
    line-height: 1.8;
    white-space: pre-wrap;
}

.preview-logo {
    max-width: 100px;
    max-height: 100px;
    margin: 15px auto;
    display: none;
    object-fit: contain;
}

.preview audio {
    width: 100%;
    margin-top: 25px;
}

.clock {
    margin-top: 25px;
    color: #888;
    font-size: 13px;
}

.purple { --accent: #b45cff; }
.red { --accent: #ff4444; }
.blue { --accent: #00bfff; }
.green { --accent: #00ff99; }

.preview {
    border-color: var(--accent, #b45cff);
}

.preview h2 {
    color: var(--accent, #b45cff);
}

.glow {
    text-shadow: 0 0 15px var(--accent);
}

.fade {
    animation: fade 2s infinite alternate;
}

@keyframes fade {
    from { opacity: .4; }
    to { opacity: 1; }
}

.terminal {
    font-family: monospace;
    color: var(--accent);
}

footer {
    text-align: center;
    color: #555;
    padding: 30px;
    font-size: 12px;
}

@media(max-width:700px) {
    .grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">VOID STUDIO</div>
    <div class="status">● LOCAL DEMO</div>
</header>

<div class="container">

    <h1>Design Studio</h1>
    <p class="subtitle">
        Create and preview your own cyber-themed designs.
    </p>

    <div class="grid">

        <!-- EDITOR -->

        <div class="panel">

            <h2>⚙️ Customization</h2>

            <label>Title</label>
            <input id="titleInput"
                   value="VOID SYSTEM">

            <label>Message</label>
            <textarea id="messageInput">Welcome to my creative cyber demo.

This is a visual simulation created for learning and design purposes.</textarea>

            <label>Logo</label>
            <input type="file"
                   id="logoInput"
                   accept="image/*">

            <label>Theme</label>
            <select id="themeInput">
                <option value="purple">Purple</option>
                <option value="red">Red</option>
                <option value="blue">Blue</option>
                <option value="green">Green</option>
            </select>

            <label>Animation</label>
            <select id="animationInput">
                <option value="glow">Neon Glow</option>
                <option value="fade">Fade</option>
                <option value="terminal">Terminal</option>
                <option value="none">None</option>
            </select>

            <label>Background Audio</label>
            <input type="file"
                   id="audioInput"
                   accept="audio/*">

            <button onclick="updatePreview()">
                UPDATE PREVIEW
            </button>

            <button onclick="resetDesign()"
                    style="background:#333">
                RESET
            </button>

        </div>

        <!-- PREVIEW -->

        <div class="panel">

            <h2>👁 Live Preview</h2>

            <div class="preview purple" id="preview">

                <img id="previewLogo"
                     class="preview-logo">

                <h2 id="previewTitle" class="glow">
                    VOID SYSTEM
                </h2>

                <p id="previewMessage">
                    Welcome to my creative cyber demo.
                </p>

                <div class="clock" id="clock">
                    00:00:00
                </div>

                <audio id="audioPlayer"
                       controls
                       style="display:none">
                </audio>

            </div>

        </div>

    </div>

</div>

<footer>
    VOID STUDIO • LOCAL DESIGN SIMULATOR
</footer>

<script>

const titleInput =
    document.getElementById("titleInput");

const messageInput =
    document.getElementById("messageInput");

const themeInput =
    document.getElementById("themeInput");

const animationInput =
    document.getElementById("animationInput");

const preview =
    document.getElementById("preview");

const previewTitle =
    document.getElementById("previewTitle");

const previewMessage =
    document.getElementById("previewMessage");

const previewLogo =
    document.getElementById("previewLogo");

const audioPlayer =
    document.getElementById("audioPlayer");


function updatePreview() {

    previewTitle.textContent =
        titleInput.value || "VOID SYSTEM";

    previewMessage.textContent =
        messageInput.value;

    preview.className =
        "preview " + themeInput.value;

    previewTitle.className = "";

    const animation =
        animationInput.value;

    if(animation === "glow") {
        previewTitle.classList.add("glow");
    }

    if(animation === "fade") {
        previewTitle.classList.add("fade");
    }

    if(animation === "terminal") {
        previewTitle.classList.add("terminal");
    }
}


// Logo upload

document.getElementById("logoInput")
.addEventListener("change", function(event) {

    const file = event.target.files[0];

    if(!file) return;

    const reader = new FileReader();

    reader.onload = function(e) {

        previewLogo.src = e.target.result;
        previewLogo.style.display = "block";

    };

    reader.readAsDataURL(file);

});


// Audio upload

document.getElementById("audioInput")
.addEventListener("change", function(event) {

    const file = event.target.files[0];

    if(!file) return;

    audioPlayer.src =
        URL.createObjectURL(file);

    audioPlayer.style.display = "block";

});


// Live update

titleInput.addEventListener("input", updatePreview);

messageInput.addEventListener("input", updatePreview);

themeInput.addEventListener("change", updatePreview);

animationInput.addEventListener("change", updatePreview);


// Clock

function updateClock() {

    const now = new Date();

    document.getElementById("clock")
    .textContent = now.toLocaleTimeString();

}

setInterval(updateClock, 1000);

updateClock();


// Reset

function resetDesign() {

    titleInput.value = "VOID SYSTEM";

    messageInput.value =
        "Welcome to my creative cyber demo.\n\nThis is a visual simulation created for learning and design purposes.";

    themeInput.value = "purple";

    animationInput.value = "glow";

    previewLogo.style.display = "none";

    audioPlayer.pause();
    audioPlayer.removeAttribute("src");
    audioPlayer.style.display = "none";

    updatePreview();

}

updatePreview();

</script>

</body>
</html>
