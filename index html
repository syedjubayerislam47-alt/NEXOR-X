
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOID Studio | Cyber Design Lab</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #080810;
    color: #f1f1f5;
    font-family: Arial, sans-serif;
}

header {
    padding: 20px;
    background: #11111c;
    border-bottom: 1px solid #35244e;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h2 {
    color: #b78aff;
    letter-spacing: 2px;
}

.status {
    color: #4ade80;
    font-size: 12px;
}

.layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    padding: 20px;
}

.panel {
    background: #11111b;
    border: 1px solid #29243c;
    padding: 20px;
    border-radius: 12px;
}

.panel h3 {
    color: #b78aff;
    margin-bottom: 18px;
}

label {
    display: block;
    font-size: 13px;
    color: #aaa;
    margin: 15px 0 7px;
}

input, textarea, select {
    width: 100%;
    padding: 11px;
    background: #080810;
    color: white;
    border: 1px solid #37304c;
    border-radius: 7px;
}

textarea {
    resize: vertical;
    min-height: 100px;
}

button {
    padding: 11px 15px;
    border: 1px solid #9560db;
    background: #25153b;
    color: white;
    border-radius: 7px;
    cursor: pointer;
    margin-top: 12px;
}

button:hover {
    background: #6b35a5;
}

.preview {
    min-height: 550px;
    border: 1px solid #7541a8;
    border-radius: 12px;
    padding: 25px;
    background:
        radial-gradient(circle at top, #24143d, #080810 65%);
    display: flex;
    justify-content: center;
    align-items: center;
}

.notice {
    width: 100%;
    max-width: 600px;
    text-align: center;
}

.logo {
    width: 100px;
    height: 100px;
    margin: auto auto 20px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 0 25px var(--accent);
}

.logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.logo span {
    font-size: 28px;
    font-weight: bold;
    color: var(--accent);
}

.notice h1 {
    font-size: clamp(24px, 5vw, 48px);
    margin-bottom: 15px;
    color: var(--accent);
    text-shadow: 0 0 15px var(--accent);
    overflow-wrap: anywhere;
}

.notice p {
    line-height: 1.8;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.tag {
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.clock {
    margin-top: 25px;
    color: #888;
}

#previewAudio {
    width: 100%;
    margin-top: 20px;
}

footer {
    text-align: center;
    color: #777;
    padding: 20px;
    font-size: 12px;
}

@media(max-width:700px) {
    .layout {
        grid-template-columns: 1fr;
    }

    .preview {
        min-height: 450px;
    }
}
</style>
</head>

<body>

<header>
    <h2>VOID STUDIO</h2>
    <span class="status">● LOCAL LAB</span>
</header>

<div class="layout">

    <!-- EDITOR -->
    <section class="panel">

        <h3>Design Editor</h3>

        <label>Display Name</label>
        <input id="nameInput" value="VOID//SYSTEM">

        <label>Custom Message</label>
        <textarea id="messageInput">Welcome to my cybersecurity design lab.

This is a visual simulation.
No real systems are accessed.</textarea>

        <label>Accent Color</label>
        <select id="colorInput">
            <option value="#b78aff">Purple Neon</option>
            <option value="#ff3b5c">Red Neon</option>
            <option value="#00e5ff">Cyan Neon</option>
            <option value="#39ff88">Green Neon</option>
            <option value="#ffb020">Amber Neon</option>
        </select>

        <label>Upload Logo</label>
        <input type="file" id="logoInput" accept="image/*">

        <label>Upload Audio (Optional)</label>
        <input type="file" id="audioInput" accept="audio/*">

        <button onclick="resetDesign()">Reset Design</button>

    </section>

    <!-- PREVIEW -->
    <section class="preview" id="preview">

        <div class="notice">

            <div class="tag">LOCAL SIMULATION</div>

            <div class="logo" id="logo">
                <span>VS</span>
            </div>

            <h1 id="previewName">VOID//SYSTEM</h1>

            <p id="previewMessage">
Welcome to my cybersecurity design lab.

This is a visual simulation.
No real systems are accessed.
            </p>

            <div class="clock" id="clock"></div>

            <audio id="previewAudio" controls hidden></audio>

        </div>

    </section>

</div>

<footer>
    VOID STUDIO • CYBER DESIGN LAB • LOCAL PREVIEW ONLY
</footer>

<script>

/* Name */

const nameInput = document.getElementById("nameInput");

nameInput.addEventListener("input", () => {
    document.getElementById("previewName").textContent =
        nameInput.value || "VOID//SYSTEM";
});

/* Message */

document.getElementById("messageInput")
.addEventListener("input", function() {

    document.getElementById("previewMessage")
    .textContent = this.value;

});

/* Theme */

document.getElementById("colorInput")
.addEventListener("change", function() {

    document.getElementById("preview")
    .style.setProperty("--accent", this.value);

});

/* Logo */

document.getElementById("logoInput")
.addEventListener("change", function() {

    const file = this.files[0];

    if (!file) return;

    const reader = new FileReader();

    reader.onload = function(event) {

        const logo = document.getElementById("logo");

        logo.innerHTML = "";

        const img = document.createElement("img");

        img.src = event.target.result;

        logo.appendChild(img);

    };

    reader.readAsDataURL(file);

});

/* Audio */

document.getElementById("audioInput")
.addEventListener("change", function() {

    const file = this.files[0];

    if (!file) return;

    const audio = document.getElementById("previewAudio");

    audio.src = URL.createObjectURL(file);

    audio.hidden = false;

});

/* Clock */

function updateClock() {

    document.getElementById("clock")
    .textContent = new Date().toLocaleString();

}

setInterval(updateClock, 1000);

updateClock();

/* Reset */

function resetDesign() {

    location.reload();

}

</script>

</body>
</html>
